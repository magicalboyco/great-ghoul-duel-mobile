{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghost-duel-rooms",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "GHOST_ROOMS", "class_name": "GhostRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GhostRoom"] }]
}
